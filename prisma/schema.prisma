// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./navada.db"
}

model Supporter {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  message   String?
  createdAt DateTime @default(now())
}

model Participant {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  contact   String?
  message   String?
  createdAt DateTime @default(now())
}
